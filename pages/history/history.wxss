.history-top,.history-bottom{display:flex;align-items:center;justify-content:space-between}.period{margin-top:8rpx;color:#687887;font-size:26rpx}.amount{font-size:36rpx;font-weight:700;color:#203b58}.history-bottom{margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #edf0f3;color:#748290;font-size:24rpx}.settled{color:#21865a;font-weight:650}
.month-filter{margin:18rpx 0 24rpx;padding:20rpx 24rpx;border:1rpx solid #dce3e9;border-radius:14rpx;background:#fff;color:#36516a;font-size:26rpx}
.scope-tabs{display:flex;gap:12rpx;margin:-8rpx 0 24rpx}.scope-tab{padding:13rpx 26rpx;border:1rpx solid #dce3e9;border-radius:28rpx;background:#fff;color:#647485;font-size:25rpx}.scope-tab.active{border-color:#123b67;background:#123b67;color:#fff}.history-owner{margin-top:14rpx;color:#7d8a96;font-size:23rpx}
