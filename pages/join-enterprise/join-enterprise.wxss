.join-page { display:flex;align-items:center;justify-content:center; }
.join-card { box-sizing:border-box;width:100%;padding:42rpx 34rpx;border:1rpx solid var(--ledger-border);border-radius:22rpx;background:var(--ledger-surface);box-shadow:0 14rpx 40rpx rgba(23,63,104,.08); }
.join-kicker { color:var(--ledger-primary);font-size:24rpx;font-weight:650; }
.enterprise-title { margin-top:10rpx;color:var(--ledger-text);font-size:42rpx;font-weight:750;line-height:1.35; }
.join-copy { margin-top:20rpx;color:var(--ledger-text-secondary);font-size:27rpx;line-height:1.7; }
.name-tip { margin-top:11rpx;color:var(--ledger-text-muted);font-size:23rpx; }
.join-button { margin-top:32rpx; }
.error-card { text-align:center; }
.error-title { color:var(--ledger-danger);font-size:34rpx;font-weight:700; }
.error-text { margin-top:18rpx;color:var(--ledger-text-secondary);line-height:1.7; }
