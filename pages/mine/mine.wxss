.profile-card{display:flex;align-items:center;padding:36rpx;border-radius:24rpx;background:#123b67;color:#fff}.enterprise-avatar{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;margin-right:24rpx;border-radius:22rpx;background:#fff;color:#123b67;font-size:38rpx;font-weight:700}.enterprise-name{font-size:34rpx;font-weight:700}.profile-meta{margin-top:8rpx;opacity:.75;font-size:24rpx}.menu-card{margin-top:24rpx;padding:0 28rpx;border-radius:20rpx;background:#fff;border:1rpx solid #e3e8ed}.menu-row{display:flex;align-items:center;justify-content:space-between;min-height:98rpx;border-bottom:1rpx solid #edf0f3;color:#23374c;font-size:29rpx}.menu-row:last-child{border-bottom:0}.dev-card{margin-top:16rpx}.logout-button{margin-top:30rpx;border-radius:16rpx;background:#fff;color:#c43d3d;font-size:29rpx}
