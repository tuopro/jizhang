.profile-card { display:flex;align-items:center;padding:34rpx;border:1rpx solid var(--ledger-primary-strong);border-radius:20rpx;background:var(--ledger-primary);color:#fff;box-shadow:0 14rpx 34rpx rgba(23,63,104,.16); }
.enterprise-avatar { display:flex;align-items:center;justify-content:center;flex-shrink:0;width:82rpx;height:82rpx;margin-right:22rpx;border-radius:20rpx;background:#fff;color:var(--ledger-primary);font-size:36rpx;font-weight:700; }
.profile-card > view:last-child { min-width:0; }
.enterprise-name { overflow:hidden;font-size:33rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap; }
.profile-meta { margin-top:7rpx;opacity:.78;font-size:23rpx; }
.menu-card { margin-top:20rpx;padding:0 26rpx;border:1rpx solid var(--ledger-border);border-radius:var(--ledger-card-radius);background:var(--ledger-surface);box-shadow:var(--ledger-card-shadow); }
.menu-row { display:flex;align-items:center;justify-content:space-between;min-height:96rpx;border-bottom:1rpx solid var(--ledger-divider);color:var(--ledger-text);font-size:29rpx; }
.menu-row text:last-child { color:var(--ledger-text-muted);font-size:32rpx; }
.menu-row:last-child { border-bottom:0; }
.dev-card { margin-top:14rpx; }
.logout-button { margin-top:28rpx;border:1rpx solid #e0a7ad;border-radius:var(--ledger-button-radius);background:var(--ledger-surface);color:var(--ledger-danger);font-size:29rpx; }
