.identity-note{color:#526170;font-size:25rpx;line-height:1.7}.invite-actions{display:grid;gap:16rpx}.invite-actions button{margin:0}.invite-card{display:grid;gap:16rpx;padding:26rpx;border:1rpx solid #d9e2ea;border-radius:18rpx;background:#fff}.invite-title{font-size:30rpx;font-weight:700;color:#1d3042}.invite-row{display:flex;justify-content:space-between;gap:20rpx;color:#526170;font-size:25rpx}.invite-active{color:#21865a;font-weight:600}.invite-tip{color:#758493;font-size:23rpx;line-height:1.6;text-align:center}.revoke-invite-button{border:1rpx solid #d9a0a0!important;background:#fff!important;color:#b53333!important}.legacy-button{margin-top:22rpx;border:1rpx solid #d59b45;border-radius:14rpx;background:#fff8eb;color:#9a5f09;font-size:26rpx}.member-list{padding-top:4rpx;padding-bottom:4rpx}.member-row{display:flex;align-items:center;justify-content:space-between;min-height:118rpx;border-bottom:1rpx solid #edf0f3}.member-row:last-child{border-bottom:0}.member-main{min-width:0}.member-actions{display:flex;gap:22rpx;margin-left:18rpx}.text-action{color:#245f94;font-size:25rpx}.self-mark{display:inline-block;margin-left:10rpx;padding:2rpx 10rpx;border-radius:12rpx;background:#e9f2fa;color:#245f94;font-size:20rpx;vertical-align:middle}.disabled-true{opacity:.62}
