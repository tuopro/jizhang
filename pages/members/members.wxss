.identity-note { border-left:5rpx solid var(--ledger-primary);color:var(--ledger-text-secondary);font-size:25rpx;line-height:1.7; }
.invite-actions { display:grid;gap:16rpx; }
.invite-actions button { margin:0; }
.invite-card { display:grid;gap:16rpx;padding:26rpx;border:1rpx solid #cfdde8;border-radius:var(--ledger-card-radius);background:var(--ledger-surface);box-shadow:var(--ledger-card-shadow); }
.invite-title { color:var(--ledger-text);font-size:30rpx;font-weight:700; }
.invite-row { display:flex;justify-content:space-between;gap:20rpx;color:var(--ledger-text-secondary);font-size:25rpx; }
.invite-active { color:var(--ledger-success);font-weight:600; }
.invite-tip { color:var(--ledger-text-muted);font-size:23rpx;line-height:1.6;text-align:center; }
.revoke-invite-button { border:1rpx solid #e0a7ad!important;border-radius:var(--ledger-button-radius);background:var(--ledger-surface)!important;color:var(--ledger-danger)!important; }
.legacy-button { margin-top:22rpx;border:1rpx solid #d8ac6c;border-radius:var(--ledger-button-radius);background:var(--ledger-warning-soft);color:var(--ledger-warning);font-size:26rpx; }
.member-list { padding-top:2rpx;padding-bottom:2rpx; }
.member-row { display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:118rpx;border-bottom:1rpx solid var(--ledger-divider); }
.member-row:last-child { border-bottom:0; }
.member-main { min-width:0;flex:1; }
.member-actions { display:flex;flex-shrink:0;gap:20rpx;margin-left:8rpx; }
.text-action { color:var(--ledger-primary);font-size:25rpx;font-weight:600; }
.self-mark { display:inline-block;margin-left:10rpx;padding:2rpx 10rpx;border-radius:12rpx;background:var(--ledger-primary-soft);color:var(--ledger-primary);font-size:20rpx;vertical-align:middle; }
.disabled-true { opacity:.58; }

@media (max-width: 340px) {
  .member-actions { gap:14rpx; }
  .text-action { font-size:24rpx; }
}
