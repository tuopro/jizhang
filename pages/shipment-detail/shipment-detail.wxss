.detail-head { padding:30rpx;border:1rpx solid var(--ledger-border);border-radius:var(--ledger-card-radius);background:var(--ledger-surface);box-shadow:var(--ledger-card-shadow); }
.detail-head-copy { padding-bottom:22rpx;border-bottom:1rpx solid var(--ledger-divider);overflow-wrap:anywhere;word-break:break-word; }
.detail-date { margin-top:8rpx;color:var(--ledger-text-muted);font-size:24rpx;line-height:1.5; }
.detail-amount-label { margin-top:22rpx;color:var(--ledger-text-secondary);font-size:23rpx;font-weight:600; }
.detail-total { margin-top:5rpx;color:var(--ledger-amount);font-size:48rpx;font-weight:700;line-height:1.2; }
.line-title { color:var(--ledger-text);font-size:30rpx;font-weight:700;line-height:1.45;overflow-wrap:anywhere;word-break:break-word; }
.line-row { display:flex;justify-content:space-between;gap:24rpx;margin-top:16rpx;color:var(--ledger-text-secondary);font-size:25rpx; }
.line-row text:first-child { flex-shrink:0; }
.line-row text:last-child { min-width:0;color:var(--ledger-text);text-align:right;overflow-wrap:anywhere;word-break:break-word; }
.amount-row { padding-top:16rpx;border-top:1rpx solid var(--ledger-divider);font-weight:700; }
.amount-row text:last-child { color:var(--ledger-amount); }
.meta-card { color:var(--ledger-text-secondary);line-height:1.9;overflow-wrap:anywhere;word-break:break-word; }
.settled-tip { padding:22rpx;border:1rpx solid #b9ddca;border-radius:var(--ledger-control-radius);background:var(--ledger-success-soft);color:var(--ledger-success);text-align:center; }
.compact-card { padding-top:2rpx;padding-bottom:2rpx; }
.amount-summary-card { color:var(--ledger-text-secondary); }
.summary-row { display:flex;justify-content:space-between;gap:24rpx;margin-top:14rpx; }
.summary-row text:last-child { flex-shrink:0;text-align:right;white-space:nowrap; }
.summary-row:first-child { margin-top:0; }
.summary-divider { margin:18rpx 0;border-top:2rpx solid var(--ledger-border); }
.summary-total { color:var(--ledger-text);font-size:30rpx;font-weight:700; }
.summary-total text:last-child { color:var(--ledger-amount); }
