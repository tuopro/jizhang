.tabs{display:grid;grid-template-columns:1fr 1fr;margin-bottom:18rpx;padding:6rpx;border-radius:16rpx;background:#e8edf2}.tab{padding:18rpx;text-align:center;color:#657483;border-radius:12rpx}.tab.active{background:#fff;color:#123b67;font-weight:700}.product-note{margin:18rpx 4rpx 24rpx;color:#778592;font-size:23rpx;line-height:1.6}.compact-card{padding-top:4rpx;padding-bottom:4rpx}.product-row{gap:16rpx}.inactive{text-decoration:line-through;color:#8b959e}.mini-action{width:112rpx;margin:0;padding:0;border-radius:12rpx;background:#f1f4f7;color:#496078;font-size:24rpx;line-height:62rpx}
