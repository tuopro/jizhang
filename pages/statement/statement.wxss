.statement-paper{padding:38rpx 30rpx;border:1rpx solid #dfe5ea;border-radius:18rpx;background:#fff}.statement-title{text-align:center;font-size:40rpx;font-weight:700;color:#152a40}.statement-client{margin-top:28rpx;font-size:32rpx;font-weight:700}.statement-period{margin-top:10rpx;color:#6c7b88;font-size:24rpx}.status-chip{display:inline-block;margin-top:18rpx;padding:8rpx 18rpx;border-radius:20rpx;background:#fff0e2;color:#b8620b;font-size:23rpx}.status-chip.settled{background:#e8f7ef;color:#21865a}.statement-section{margin:36rpx 0 16rpx;padding-bottom:12rpx;border-bottom:2rpx solid #173d66;font-weight:700}.shipment-block{margin-bottom:22rpx}.shipment-header{display:flex;justify-content:space-between;padding:14rpx 0;background:#f4f7f9;font-weight:650}.statement-line{padding:16rpx 0;border-bottom:1rpx solid #edf0f3}.line-product{font-weight:600}.line-meta{display:flex;justify-content:space-between;margin-top:8rpx;color:#667685;font-size:24rpx}.payment-line{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #edf0f3}.empty-inline{color:#82909d;font-size:25rpx}.totals{margin-top:34rpx;padding-top:20rpx;border-top:2rpx solid #173d66}.totals>view{display:flex;justify-content:space-between;margin-top:18rpx}.outstanding-total{font-size:32rpx;font-weight:700}.export-note{margin:24rpx 8rpx;color:#7a8793;font-size:23rpx;line-height:1.6}
.shipment-totals{margin-top:8rpx;padding:14rpx 0;border-bottom:1rpx solid #dfe5ea;color:#5e6f7e;font-size:23rpx}.shipment-totals>view{display:flex;justify-content:space-between;margin-top:8rpx}.shipment-totals>view:first-child{margin-top:0}.shipment-total-row{padding-top:10rpx;border-top:1rpx dashed #d5dde4;color:#213b54;font-weight:700}
