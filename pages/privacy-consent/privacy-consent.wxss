.privacy-page { display:flex;align-items:center;justify-content:center;padding-bottom:calc(48rpx + env(safe-area-inset-bottom)); }
.privacy-card { box-sizing:border-box;width:100%;padding:42rpx 34rpx;border:1rpx solid var(--ledger-border);border-radius:22rpx;background:var(--ledger-surface);box-shadow:0 14rpx 40rpx rgba(23,63,104,.08); }
.privacy-mark { display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;margin:0 auto;border-radius:20rpx;background:var(--ledger-primary);color:#fff;font-size:27rpx;font-weight:750; }
.privacy-title { margin-top:26rpx;color:var(--ledger-text);font-size:40rpx;font-weight:750;text-align:center; }
.privacy-description { margin-top:22rpx;color:var(--ledger-text-secondary);font-size:27rpx;line-height:1.8; }
.consent-row { display:flex;align-items:center;flex-wrap:wrap;margin-top:30rpx;padding:22rpx;border:1rpx solid var(--ledger-border);border-radius:var(--ledger-control-radius);background:#f7f9fb;font-size:26rpx;line-height:1.7; }
.consent-check { display:flex;align-items:center;color:var(--ledger-text); }
.consent-check checkbox { margin-right:8rpx;transform:scale(.9); }
.privacy-link { color:var(--ledger-primary);font-weight:650;text-decoration:underline; }
.privacy-status,.privacy-error { margin-top:18rpx;color:var(--ledger-text-muted);font-size:24rpx;line-height:1.6; }
.privacy-error { color:var(--ledger-danger); }
.retry-status-button { margin-top:18rpx; }
.privacy-actions { margin-top:34rpx; }
.declined-message { text-align:center; }
.standalone-link { display:block;margin-top:24rpx;text-align:center; }
.reconsider-button { margin-top:34rpx; }

@media (max-width: 340px) {
  .privacy-card { padding-right:28rpx;padding-left:28rpx; }
}
