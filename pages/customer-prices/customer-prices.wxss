.price-head { margin-bottom:20rpx;padding:26rpx;border:1rpx solid #d4e0ea;border-radius:var(--ledger-card-radius);background:var(--ledger-primary-soft); }
.compact-card { padding-top:2rpx;padding-bottom:2rpx; }
.price-copy { min-width:0;flex:1;margin-right:12rpx; }
.price-value { flex-shrink:0;color:var(--ledger-primary);font-weight:700;white-space:nowrap; }
.mask { position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(12,28,44,.52); }
.sheet { box-sizing:border-box;width:100%;max-height:88vh;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0;background:var(--ledger-surface); }
.sheet-head { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:22rpx;color:var(--ledger-primary); }
.selected-product { padding:20rpx;border:1rpx solid #d4e0ea;border-radius:var(--ledger-control-radius);background:var(--ledger-primary-soft);color:var(--ledger-primary);font-weight:650;line-height:1.5; }
.product-results { max-height:420rpx;margin-top:12rpx; }
.product-option { padding:22rpx 8rpx;border-bottom:1rpx solid var(--ledger-divider);color:var(--ledger-text);line-height:1.5; }
.save-price { margin-top:28rpx; }
