.price-head{margin-bottom:22rpx;padding:28rpx;border-radius:20rpx;background:#eaf0f6}.compact-card{padding-top:4rpx;padding-bottom:4rpx}.price-copy{min-width:0;flex:1;margin-right:18rpx}.price-value{color:#123b67;font-weight:700}.mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(13,27,42,.45)}.sheet{box-sizing:border-box;width:100%;max-height:88vh;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.selected-product{padding:22rpx;border-radius:14rpx;background:#edf3f8;color:#173c62;font-weight:650}.product-results{max-height:420rpx;margin-top:12rpx}.product-option{padding:22rpx 8rpx;border-bottom:1rpx solid #edf0f3}.save-price{margin-top:28rpx}
