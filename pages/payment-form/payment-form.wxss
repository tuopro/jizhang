.payment-summary { border-left:5rpx solid var(--ledger-primary); }
.summary-row { display:flex;justify-content:space-between;gap:24rpx;margin-top:18rpx;color:var(--ledger-text-secondary); }
.summary-row text:last-child { flex-shrink:0;text-align:right;white-space:nowrap; }
.summary-row.important { padding-top:18rpx;border-top:1rpx solid var(--ledger-divider);color:var(--ledger-text);font-size:30rpx;font-weight:700; }
.label-action { display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx; }
.fill-link { color:var(--ledger-primary);font-size:24rpx;font-weight:600; }
.settlement-mask { position:fixed;z-index:1000;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(12,28,44,.52); }
.settlement-dialog { box-sizing:border-box;width:100%;max-width:640rpx;padding:36rpx;border:1rpx solid var(--ledger-border);border-radius:22rpx;background:var(--ledger-surface); }
.settlement-title { color:var(--ledger-text);font-size:34rpx;font-weight:700;text-align:center; }
.settlement-content { margin-top:22rpx;color:var(--ledger-text-secondary);font-size:27rpx;line-height:1.7; }
.settlement-actions { margin-top:30rpx; }
.settlement-actions button { font-size:26rpx; }
.dialog-secondary { background:#eef2f5;color:var(--ledger-text-secondary); }
.dialog-primary { background:var(--ledger-success);color:#fff; }
