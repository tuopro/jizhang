/*
 * Ledger UI tokens
 * Visual only: business state and data continue to come from page scripts.
 */
page {
  --ledger-bg: #f3f6f9;
  --ledger-surface: #ffffff;
  --ledger-primary: #173f68;
  --ledger-primary-strong: #103657;
  --ledger-primary-soft: #eaf1f7;
  --ledger-text: #1d2c3a;
  --ledger-text-secondary: #526273;
  --ledger-text-muted: #7b8996;
  --ledger-border: #dce4eb;
  --ledger-divider: #e9eef2;
  --ledger-danger: #b8323f;
  --ledger-danger-soft: #fff1f2;
  --ledger-success: #1f7a55;
  --ledger-success-soft: #eaf6f0;
  --ledger-warning: #9a5c08;
  --ledger-warning-soft: #fff6e8;
  --ledger-amount: #b34832;
  --ledger-card-radius: 18rpx;
  --ledger-button-radius: 14rpx;
  --ledger-control-radius: 12rpx;
  --ledger-control-height: 88rpx;
  --ledger-page-gutter: 28rpx;
  --ledger-card-gap: 20rpx;
  --ledger-section-gap: 32rpx;
  --ledger-title-size: 40rpx;
  --ledger-section-size: 31rpx;
  --ledger-body-size: 28rpx;
  --ledger-helper-size: 24rpx;
  --ledger-card-shadow: 0 8rpx 24rpx rgba(23, 63, 104, 0.045);
  min-height: 100%;
  background: var(--ledger-bg);
  color: var(--ledger-text);
  font-size: var(--ledger-body-size);
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: none;
}

button {
  box-sizing: border-box;
}

button:active {
  opacity: 0.88;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx var(--ledger-page-gutter) calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: var(--ledger-card-gap);
  padding: 28rpx;
  border: 1rpx solid var(--ledger-border);
  border-radius: var(--ledger-card-radius);
  background: var(--ledger-surface);
  box-shadow: var(--ledger-card-shadow);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin-right: 0;
  margin-left: 0;
  min-height: var(--ledger-control-height);
  border-radius: var(--ledger-button-radius);
  background: var(--ledger-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
}

.primary-button[disabled] {
  background: #a7b2bc;
  color: #f1f4f6;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin-right: 0;
  margin-left: 0;
  min-height: var(--ledger-control-height);
  border: 2rpx solid var(--ledger-primary);
  border-radius: var(--ledger-button-radius);
  background: var(--ledger-surface);
  color: var(--ledger-primary);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
}

.action-row {
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  gap: 16rpx;
}

.action-row > button {
  flex: 1 1 0;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
}

.muted {
  color: var(--ledger-text-muted);
}

.warning-text {
  color: var(--ledger-warning);
}

.danger-text {
  color: var(--ledger-danger);
}

.success-text {
  color: var(--ledger-success);
}

.section-title {
  color: var(--ledger-text);
  font-size: var(--ledger-section-size);
  font-weight: 700;
  line-height: 1.3;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--ledger-section-gap) 2rpx 16rpx;
}

.page-title {
  margin: 4rpx 0 22rpx;
  color: var(--ledger-text);
  font-size: var(--ledger-title-size);
  font-weight: 700;
  line-height: 1.25;
}

.search-box,
.form-input,
.form-textarea,
.picker-box {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--ledger-border);
  border-radius: var(--ledger-control-radius);
  background: var(--ledger-surface);
  color: var(--ledger-text);
  font-size: 28rpx;
}

.search-box,
.form-input,
.picker-box {
  height: var(--ledger-control-height);
  padding: 0 24rpx;
  line-height: var(--ledger-control-height);
}

.form-textarea {
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.65;
}

.form-label {
  display: block;
  margin: 24rpx 2rpx 12rpx;
  color: var(--ledger-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 98rpx;
  gap: 22rpx;
  border-bottom: 1rpx solid var(--ledger-divider);
}

.list-row > view:first-child {
  min-width: 0;
}

.list-row:last-child {
  border-bottom: 0;
}

.row-title {
  color: var(--ledger-text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.row-note {
  margin-top: 6rpx;
  color: var(--ledger-text-muted);
  font-size: var(--ledger-helper-size);
  line-height: 1.5;
}

.amount-danger {
  flex-shrink: 0;
  color: var(--ledger-amount);
  font-weight: 700;
  white-space: nowrap;
}

.amount-success {
  flex-shrink: 0;
  color: var(--ledger-success);
  font-weight: 700;
  white-space: nowrap;
}

.empty-state {
  padding: 52rpx 24rpx;
  color: var(--ledger-text-muted);
  text-align: center;
  line-height: 1.7;
}

.fixed-action-space {
  height: 144rpx;
}

.fixed-action {
  position: fixed;
  right: var(--ledger-page-gutter);
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: var(--ledger-page-gutter);
  z-index: 8;
  box-shadow: 0 12rpx 30rpx rgba(23, 63, 104, 0.2);
}

@media (max-width: 340px) {
  .page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .card {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .fixed-action {
    right: 22rpx;
    left: 22rpx;
  }

  .action-row--responsive {
    flex-direction: column;
  }

  .action-row--responsive > button {
    width: 100%;
  }
}
